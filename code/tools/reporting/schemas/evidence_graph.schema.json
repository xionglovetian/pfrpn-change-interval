{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pf-rpn.local/schemas/evidence_graph.v1.json",
  "title": "M3 EG-RR evidence_graph.v1",
  "type": "object",
  "required": ["schema_version", "candidate_id", "evidence", "links", "missing_evidence"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "evidence_graph.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "event_id": {"type": ["string", "null"]},
    "image_id": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "group", "name", "value", "normalized_score", "direction", "quality", "uncertainty", "source", "method"],
        "additionalProperties": true,
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"},
          "group": {"enum": ["geometry", "terrain", "spectral", "sar", "meteorology", "environment", "historical", "model"]},
          "name": {"type": "string"},
          "value": {"type": ["number", "string", "boolean", "null"]},
          "unit": {"type": ["string", "null"]},
          "normalized_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "direction": {"enum": ["increase", "decrease", "context"]},
          "quality": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "source": {"type": "string"},
          "method": {"type": "string"},
          "raw_key": {"type": ["string", "null"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation"],
        "additionalProperties": true,
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"enum": ["supports", "weakens", "contextualizes", "derives_from"]},
          "weight": {"type": ["number", "null"], "minimum": -1, "maximum": 1}
        }
      }
    },
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "hazard": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "level": {"enum": ["very_low", "low", "moderate", "high", "very_high", "unknown"]},
        "terminology": {"enum": ["hazard", "susceptibility"]},
        "model_name": {"type": "string"},
        "attributions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "missing_groups": {"type": "array", "items": {"type": "string"}}
      }
    },
    "uncertainty": {"type": ["object", "null"], "additionalProperties": true},
    "risk_level": {"type": "null"},
    "risk_level_reason": {"type": ["string", "null"]},
    "provenance": {"type": "object", "additionalProperties": true}
  }
}